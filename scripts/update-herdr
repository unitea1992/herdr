#!/usr/bin/env bash
# update-herdr — Linux-only updater for the personal herdr fork
# (unitea1992/herdr, branch local/tabby-cwd). This script is the source of
# truth; the installer copies it to $BIN_DIR/update-herdr.
#
# Usage: update-herdr [--check] [--clean]
#   no flags  fetch upstream+origin, rebase local/tabby-cwd onto
#             upstream/master, force-push the fork, build the release binary
#             with custom version metadata, install it to $BIN_DIR/herdr.
#   --check   same fetch/rebase/push, then run Linux-native checks (fmt,
#             clippy, nextest, release build) WITHOUT installing anything.
#   --clean   `cargo clean` before the build (use after repo moves when stale
#             cache paths break the vendored zig build).
#
# This fork is Linux-only: never installs or runs Windows/macOS targets,
# PowerShell tooling, or the official updater (`herdr update` is blocked by
# the .bashrc wrapper). Checks never depend on `just`.
set -euo pipefail

REPO="${HERDR_LOCAL_REPO:-$HOME/projects/herdr}"
BIN_DIR="${HERDR_LOCAL_BIN:-$HOME/.local/bin}"
BRANCH="local/tabby-cwd"
BINARY="$BIN_DIR/herdr"
ZIG_VERSION="0.15.2"

check_mode=0
clean_mode=0
for arg in "$@"; do
    case "$arg" in
        --check) check_mode=1 ;;
        --clean) clean_mode=1 ;;
        *)
            echo "usage: update-herdr [--check] [--clean]" >&2
            exit 2
            ;;
    esac
done

die() {
    echo "error: $*" >&2
    exit 1
}

require_cmd() {
    local cmd="$1"
    command -v "$cmd" >/dev/null 2>&1 || die "required command '$cmd' is not on PATH"
}

# Resolve zig 0.15.2 as a complete installation (zig binary + lib/ + docs
# tree), the layout the installer keeps under
# $HOME/.local/share/herdr/zig-$ZIG_VERSION/. Resolution: the herdr-managed
# complete tree first (this also heals the old broken lone $HOME/.local/bin/zig
# layout), then an exact-version PATH zig whose real location has a lib/ next
# to it. A bare single zig binary is never usable (Zig needs its installation
# tree for the vendored libghostty-vt build), so it is never picked.
zig_complete() {
    local real
    real="$(readlink -f "$1" 2>/dev/null || echo "$1")"
    [[ -x "$real" ]] && [[ -d "${real%/*}/lib" ]]
}

resolve_zig() {
    local managed="$HOME/.local/share/herdr/zig-$ZIG_VERSION/zig"
    if zig_complete "$managed"; then
        echo "$managed"
        return
    fi
    if command -v zig >/dev/null 2>&1 \
        && [[ "$(zig version 2>/dev/null)" == "$ZIG_VERSION" ]] \
        && zig_complete "$(command -v zig)"; then
        echo "zig"
        return
    fi
    echo "ERROR: zig $ZIG_VERSION (complete installation with lib/) is required." >&2
    echo "  managed tree $HOME/.local/share/herdr/zig-$ZIG_VERSION is missing or incomplete." >&2
    echo "  Install/repair it with the one-line installer:" >&2
    echo "    curl -fsSL https://raw.githubusercontent.com/unitea1992/herdr/local/tabby-cwd/install-tabbycwd.sh | bash" >&2
    exit 1
}

preflight_build_deps() {
    require_cmd cargo
    require_cmd rustc
    ZIG="$(resolve_zig)"
    export ZIG
}

preflight_check_deps() {
    preflight_build_deps
    if ! command -v cargo-nextest >/dev/null 2>&1; then
        cat >&2 <<'EOF'
ERROR: cargo-nextest is required for --check.
Install with:
  cargo binstall cargo-nextest --no-confirm
EOF
        exit 1
    fi
    cargo fmt --version >/dev/null 2>&1 || die "rustfmt is missing; install with: rustup component add rustfmt"
    cargo clippy --version >/dev/null 2>&1 || die "clippy is missing; install with: rustup component add clippy"
}

build_and_install() {
    preflight_build_deps
    if [[ "$clean_mode" == 1 ]]; then
        echo "== cargo clean =="
        cargo clean
    fi
    local head_sha
    head_sha="$(git rev-parse --short HEAD)"
    echo "== cargo build --release (channel=tabbycwd, id=$head_sha) =="
    HERDR_BUILD_CHANNEL=tabbycwd HERDR_BUILD_ID="$head_sha" cargo build --release --locked
    echo "== install to $BINARY =="
    install -Dm755 target/release/herdr "$BINARY"
}

run_checks() {
    preflight_check_deps
    if [[ "$clean_mode" == 1 ]]; then
        echo "== cargo clean =="
        cargo clean
    fi
    local head_sha
    head_sha="$(git rev-parse --short HEAD)"

    # fmt/clippy/nextest run on the stable channel: the test suite asserts
    # env!("CARGO_PKG_VERSION") (e.g. tests/api_ping.rs), so custom version
    # metadata is applied only to the release build below, matching how the
    # artifact is produced.
    echo "== cargo fmt --check =="
    cargo fmt --check
    echo "== cargo clippy --all-targets --locked -- -D warnings =="
    cargo clippy --all-targets --locked -- -D warnings
    echo "== cargo nextest run --locked =="
    cargo nextest run --locked \
        --status-level fail \
        --final-status-level slow \
        --failure-output final \
        --success-output never
    echo "== cargo build --release --locked (channel=tabbycwd, id=$head_sha, no install) =="
    HERDR_BUILD_CHANNEL=tabbycwd HERDR_BUILD_ID="$head_sha" cargo build --release --locked
    echo "== built binary version =="
    ./target/release/herdr --version
}

main() {
    cd "$REPO" || die "repo not found at $REPO (run the one-line installer first, see LOCAL.md)"

    if [[ -n "$(git status --porcelain)" ]]; then
        echo "error: working tree is dirty; commit or stash before updating" >&2
        git status --short >&2
        exit 1
    fi
    if [[ "$(git branch --show-current)" != "$BRANCH" ]]; then
        echo "error: expected branch '$BRANCH', currently on '$(git branch --show-current)'" >&2
        exit 1
    fi
    git remote get-url upstream >/dev/null 2>&1 || die "remote 'upstream' missing (add: git remote add upstream https://github.com/herdrdev/herdr.git)"
    git remote get-url origin >/dev/null 2>&1 || die "remote 'origin' missing"

    local upstream_before
    upstream_before="$(git rev-parse --short upstream/master)"

    echo "== fetch upstream + origin =="
    git fetch upstream
    git fetch origin

    local upstream_after
    upstream_after="$(git rev-parse --short upstream/master)"

    echo "== rebase $BRANCH onto upstream/master =="
    if ! git rebase upstream/master; then
        echo
        echo "error: rebase conflicts; resolve manually, then run: git rebase --continue" >&2
        echo "conflicted files:" >&2
        git diff --name-only --diff-filter=U >&2
        exit 1
    fi

    echo "== push $BRANCH to origin (--force-with-lease) =="
    git push --force-with-lease origin "$BRANCH"

    if [[ "$check_mode" == 1 ]]; then
        run_checks
    else
        build_and_install
    fi

    echo
    echo "Upstream before: $upstream_before"
    echo "Upstream after:  $upstream_after"
    echo "Local HEAD:      $(git rev-parse --short HEAD)"
    echo
    if [[ "$check_mode" == 1 ]]; then
        echo "check mode: Linux-native checks passed; installed binary untouched"
    fi
    "$BINARY" --version
    echo "note: a running herdr server is still the old binary; restart it at a convenient time"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
