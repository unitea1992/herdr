#!/usr/bin/env bash
# update-herdr — Linux-only updater for the personal herdr fork
# (unitea1992/herdr, branch local/tabby-cwd). This script is the source of
# truth; the installer copies it to $BIN_DIR/update-herdr.
#
# Each run shallow-clones local/tabby-cwd into a throwaway temp dir, builds
# the release binary with custom version metadata into the shared cargo
# target dir, replaces installed herdr and this updater, prints the version,
# and removes the clone. No checks, no fetch/rebase/push, no persistent
# source checkout, no GitHub auth.
set -euo pipefail

BIN_DIR="${HERDR_LOCAL_BIN:-$HOME/.local/bin}"
BINARY="$BIN_DIR/herdr"
BRANCH="local/tabby-cwd"
FORK_URL="https://github.com/unitea1992/herdr.git"
ZIG_VERSION="0.15.2"
ZIG_ROOT="$HOME/.local/share/herdr/zig-$ZIG_VERSION"
CARGO_TARGET_DIR="$HOME/.cache/herdr/target"
export CARGO_TARGET_DIR

die() {
    echo "error: $*" >&2
    exit 1
}

require_cmd() {
    local cmd="$1"
    command -v "$cmd" >/dev/null 2>&1 || die "required command '$cmd' is not on PATH"
}

# Resolve zig 0.15.2 as a complete installation (zig binary + lib/ + docs
# tree), the layout the installer keeps under $ZIG_ROOT/. Resolution: the
# herdr-managed complete tree first, then an exact-version PATH zig whose real
# location has a lib/ next to it. A bare single zig binary is never usable
# (Zig needs its installation tree for the vendored libghostty-vt build), so
# it is never picked.
zig_complete() {
    local real
    real="$(readlink -f "$1" 2>/dev/null || echo "$1")"
    [[ -x "$real" ]] && [[ -d "${real%/*}/lib" ]]
}

resolve_zig() {
    local managed="$ZIG_ROOT/zig"
    if zig_complete "$managed"; then
        echo "$managed"
        return
    fi
    if command -v zig >/dev/null 2>&1 \
        && [[ "$(zig version 2>/dev/null)" == "$ZIG_VERSION" ]] \
        && zig_complete "$(command -v zig)"; then
        echo "zig"
        return
    fi
    echo "ERROR: zig $ZIG_VERSION (complete installation with lib/) is required." >&2
    echo "  managed tree $ZIG_ROOT is missing or incomplete." >&2
    echo "  Install/repair it with the one-line installer:" >&2
    echo "    curl -fsSL https://raw.githubusercontent.com/unitea1992/herdr/local/tabby-cwd/install-tabbycwd.sh | bash" >&2
    exit 1
}

preflight_build_deps() {
    require_cmd cargo
    require_cmd rustc
    # Export so the cargo subprocess below resolves vendored libghostty-vt's
    # zig 0.15.2, and the updater never installs anything extra.
    export ZIG="$(resolve_zig)"
}

# Shallow-clone only branch $BRANCH at its current HEAD; no other history or
# branches. The clone lives in the throwaway $WORK dir and is removed by the
# EXIT trap in main().
clone_fork() {
    echo "== clone $FORK_URL ($BRANCH, --depth=1) =="
    git clone --depth=1 --branch "$BRANCH" "$FORK_URL" "$WORK/repo"
    HEAD_SHA="$(git -C "$WORK/repo" rev-parse --short HEAD)"
    echo "== checked out $BRANCH @ $HEAD_SHA =="
}

# Build the release binary into the shared cargo target dir; non-zero on
# failure so install is skipped and the installed binary stays untouched.
build_release() {
    local dir="$1"
    ( cd "$dir" && HERDR_BUILD_CHANNEL=tabbycwd HERDR_BUILD_ID="$HEAD_SHA" cargo build --release --locked )
}

main() {
    require_cmd git
    WORK="$(mktemp -d)"
    trap 'rm -rf "$WORK"' EXIT
    clone_fork
    preflight_build_deps
    build_release "$WORK/repo"
    echo "== install to $BINARY =="
    install -Dm755 "$CARGO_TARGET_DIR/release/herdr" "$BINARY"
    echo "== self-update $BIN_DIR/update-herdr =="
    install -Dm755 "$WORK/repo/scripts/update-herdr" "$BIN_DIR/update-herdr"
    echo
    echo "HEAD: $HEAD_SHA"
    echo
    "$BINARY" --version
    echo "note: a running herdr server is still the old binary; restart it at a convenient time"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
